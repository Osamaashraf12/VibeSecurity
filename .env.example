OLLAMA_URL_MAIN="This is updated when needed"
OLLAMA_URL_HACKER="This is updated when needed"

# OpenRouter core
OPENROUTER_API_KEY="Your openrouter api key here"
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_SITE_URL=http://localhost:8000
OPENROUTER_APP_NAME=VibeSecurity
OPENROUTER_DEFAULT_MODEL=openrouter/free

# HTTP pair analysis
OPENROUTER_HACKER_PRIMARY=openrouter/free
OPENROUTER_HACKER_FALLBACK=openrouter/free

# Hunter Agent primary models
# Each Hunter Agent node reads its model from here.
HUNTER_MODEL_THREAT_MODELLER=openrouter/free
HUNTER_MODEL_COORDINATOR=openrouter/free
HUNTER_MODEL_AUTH=openrouter/free
HUNTER_MODEL_INJECTION=openrouter/free
HUNTER_MODEL_ACCESS_CONTROL=openrouter/free
HUNTER_MODEL_BUSINESS_LOGIC=openrouter/free
HUNTER_MODEL_CLIENT_SIDE=openrouter/free
HUNTER_MODEL_INFRASTRUCTURE=openrouter/free
HUNTER_MODEL_POC_GENERATOR=openrouter/free
HUNTER_MODEL_REVISOR=openrouter/free
HUNTER_MODEL_REPORT_AGENT=openrouter/free
HUNTER_MODEL_SYNTHESIZER=openrouter/free
HUNTER_MODEL_CHAINER=openrouter/free
HUNTER_MODEL_PAYLOAD_GENERATOR=openrouter/free

# Hunter Agent fallback models
# Used when the primary model fails (capacity error, deprecation, etc.)
HUNTER_FALLBACK_SYNTHESIZER=openrouter/free
HUNTER_FALLBACK_CHAINER=openrouter/free
HUNTER_FALLBACK_THREAT_MODELLER=openrouter/free
HUNTER_FALLBACK_COORDINATOR=openrouter/free
HUNTER_FALLBACK_AUTH=openrouter/free
HUNTER_FALLBACK_INJECTION=openrouter/free
HUNTER_FALLBACK_ACCESS_CONTROL=openrouter/free
HUNTER_FALLBACK_BUSINESS_LOGIC=openrouter/free
HUNTER_FALLBACK_CLIENT_SIDE=openrouter/free
HUNTER_FALLBACK_INFRASTRUCTURE=openrouter/free
HUNTER_FALLBACK_POC_GENERATOR=openrouter/free
HUNTER_FALLBACK_REVISOR=openrouter/free
HUNTER_FALLBACK_REPORT_AGENT=openrouter/free

# Project paths
VIBESEC_STATIC_DIR=data/static
VIBESEC_RUNTIME_DIR=var
